# =================================================================
# EDUGUARD 360 - ENTERPRISE CAMPUS ENVIRONMENT CONFIGURATION
# =================================================================
PORT=5050
NODE_ENV=production
CLIENT_URL=https://campus.institution.edu

# Database Connection (MongoDB Atlas URI or Self-Hosted Replica Set)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/eduguard360?retryWrites=true&w=majority

# Authentication & Security Tokens
JWT_SECRET=change_this_to_a_cryptographically_secure_random_string_in_production
JWT_EXPIRES_IN=7d

# Institutional Identity & Branding
INSTITUTION_NAME=University Institute of Technology & Management
INSTITUTION_CODE=UITM
INSTITUTION_DOMAIN=institution.edu
CAMPUS_HELPLINE=+91 11 2345 6789
SUPPORT_EMAIL=support@institution.edu

# Root Institutional Administrator Initial Account
ADMIN_NAME=Campus IT Dean
ADMIN_EMAIL=admin@institution.edu
ADMIN_INITIAL_PASSWORD=SetSecurePassword123!

# Gemini AI Engine (For intelligent student risk diagnostics & sentiment analysis)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Operational Mode
# Set to 'false' for live institutional deployment (disables bypasses & evaluator shortcuts)
# Set to 'true' for sandbox/evaluator evaluation demonstrations
DEMO_MODE=false

# Campus Complaint SLA Thresholds (Hours)
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=12
SLA_MEDIUM_HOURS=24
SLA_LOW_HOURS=48

# Maximum File Upload Size (MB)
MAX_FILE_SIZE_MB=10
